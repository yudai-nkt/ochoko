# Mastodon settings for the e2e stack. The secrets are fixed test values; the
# stack only runs in Docker and holds no real data.
RAILS_ENV=production
NODE_ENV=production
LOCAL_DOMAIN=mastodon.test
SINGLE_USER_MODE=false
DB_HOST=mastodon-db
DB_USER=postgres
DB_NAME=mastodon_production
DB_PASS=
DB_PORT=5432
REDIS_HOST=mastodon-redis
REDIS_PORT=6379
ES_ENABLED=false
S3_ENABLED=false
SECRET_KEY_BASE=b9eac10e90f000036aa4d0204f896633403b56f7a36ad3558c184791edd42467c8c98aa00fefe0a34259284c821e973e379ec7f7217edb019016ab44f6c159a0
OTP_SECRET=81fa6017bb505ac22dcf2dcd210f864c4a0dac6776cd6e8ab7b20ad7e70b414b81ba9b7eec7a0ffd103f1a2ffc19b65533e80165d0dea8eff6ff25d1180970a8
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=e10e47b2f682f52d8dc0f8ed76636696
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=c8aa261302dd6a3d1e7330fcc3a4c641
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=dd7131b89fa5177d25731a3291a28b3a
RAILS_LOG_LEVEL=warn
# Trust the e2e CA for outgoing HTTPS (Ruby ignores the OS store here).
SSL_CERT_FILE=/certs/rootCA.pem
# The other servers live on the Docker network (see compose.yaml).
ALLOWED_PRIVATE_ADDRESSES=172.30.0.0/24
